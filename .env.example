# Local development env. Copy to .env and edit.

# Where the backend listens.
BIND_ADDR=0.0.0.0:8080

# SQLite data directory (must be writable).
DATA_DIR=./data

# Random secret used to sign session JWTs. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-please

# OpenAI-compatible LLM (DeepSeek by default).
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Lazycat OIDC. These are injected automatically when deployed via lpk.
# For local dev with a real OIDC provider, set them manually.
# LAZYCAT_AUTH_OIDC_CLIENT_ID=
# LAZYCAT_AUTH_OIDC_CLIENT_SECRET=
# LAZYCAT_AUTH_OIDC_AUTH_URI=
# LAZYCAT_AUTH_OIDC_TOKEN_URI=
# LAZYCAT_AUTH_OIDC_USERINFO_URI=
# LAZYCAT_APP_DOMAIN=localhost:8080
