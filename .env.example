# Copy to .env and edit. Loaded by `cargo run` (via dotenvy) AND by
# `docker compose up` (compose auto-reads .env in the project root).

# --- Server (cargo run only; Compose overrides BIND_ADDR/DATA_DIR via env block)
BIND_ADDR=0.0.0.0:8080
DATA_DIR=./data

# Logging level for the Rust binary.
RUST_LOG=info

# Random secret used to sign session JWTs. REQUIRED in compose. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-please

# --- LLM (OpenAI-compatible; default DeepSeek).
# All three are OPTIONAL. They only act as a seed for the `app_settings`
# table on the very first boot (when the database still holds factory
# defaults). After you change the values from the in-app Settings page
# they take precedence and these env vars are ignored — so leaving them
# empty is fine; you can always configure the LLM from the UI.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- docker compose only
# Host port the container is published on (8080 inside container).
APP_PORT=8080
# Container time zone.
TZ=Asia/Shanghai
# Public domain used to build OIDC redirect URLs (host[:port], no scheme).
APP_DOMAIN=localhost:8080

# --- Lazycat / generic OIDC (optional)
# Injected automatically when deployed via lpk on Lazycat MicroServer.
# For local dev with a real OIDC provider, set them manually below.
# LAZYCAT_AUTH_OIDC_CLIENT_ID=
# LAZYCAT_AUTH_OIDC_CLIENT_SECRET=
# LAZYCAT_AUTH_OIDC_AUTH_URI=
# LAZYCAT_AUTH_OIDC_TOKEN_URI=
# LAZYCAT_AUTH_OIDC_USERINFO_URI=
# LAZYCAT_APP_DOMAIN=localhost:8080

# --- Email login fallback
# Lightweight password-less login for non-Lazycat deployments. The
# submitted email becomes the stable user identity ("email:<addr>")
# and is upserted into the users table — there is no email
# verification, so treat this as "现阶段认证意义不大" mode.
#
# Default: enabled automatically when no Lazycat OIDC env vars are
# present. Set to 0/false to force-disable, or 1/true to also expose
# it side-by-side with OIDC.
# EMAIL_LOGIN=1
